@namespace HairScheduling.Web.Components.Common

<div class="row mb-3">
    <div class="col-12">
        <h4>@Title</h4>
    </div>
</div>

<div class="row">
    <div class="col-12">
        @ChildContent
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <button type="submit" class="btn btn-primary">@SubmitButtonText</button>
        <button type="button" class="btn btn-secondary" @onclick="OnCancel">Cancelar</button>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "Formulario";

    [Parameter]
    public string SubmitButtonText { get; set; } = "Guardar";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }
}

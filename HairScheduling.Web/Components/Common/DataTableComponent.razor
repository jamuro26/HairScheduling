@namespace HairScheduling.Web.Components.Common
@using System.Reflection
@typeparam TItem

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            @foreach (var prop in GetProperties())
            {
                <th>@GetDisplayName(prop)</th>
            }
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Items?.Count > 0)
        {
            @foreach (var item in Items)
            {
                <tr>
                    @foreach (var prop in GetProperties())
                    {
                        <td>@prop.GetValue(item)</td>
                    }
                    <td>
                        <button class="btn btn-sm btn-warning" @onclick="() => OnEdit.InvokeAsync(item)">
                            Editar
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => OnDelete.InvokeAsync(item)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="@(GetProperties().Count + 1)" class="text-center text-muted">
                    No hay datos disponibles
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter]
    public List<TItem>? Items { get; set; }

    [Parameter]
    public EventCallback<TItem> OnEdit { get; set; }

    [Parameter]
    public EventCallback<TItem> OnDelete { get; set; }

    [Parameter]
    public List<string>? ExcludeProperties { get; set; }

    private List<PropertyInfo> GetProperties()
    {
        var exclude = ExcludeProperties ?? [];
        return typeof(TItem)
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Where(p => !exclude.Contains(p.Name))
            .ToList();
    }

    private string GetDisplayName(PropertyInfo prop)
    {
        return System.Text.RegularExpressions.Regex.Replace(prop.Name, "([a-z])([A-Z])", "$1 $2");
    }
}
